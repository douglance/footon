{
  "name": "footon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "worker-build --release --out-dir build worker",
    "check": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace && npm run build",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all --check",
    "lint": "npm run lint:rust",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "test": "cargo test --workspace"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  }
}
