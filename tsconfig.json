{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "test", "worker-configuration.d.ts"]
}
